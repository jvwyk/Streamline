<Project>

  <!--
    Test-project defaults. Inherits from the repo-root Directory.Build.props
    (explicit import chain — MSBuild stops at the first Directory.Build.props
    it finds walking upward). Every project under tests/ gets the test
    framework package references for free; individual csprojs stay minimal.
  -->

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Test code doesn't carry the same public-API quality bar as production code. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="Test frameworks">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
